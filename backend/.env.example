MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=oke_osun_diocese
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRE_DAYS=7
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithAStrongPassword123!
GCS_BUCKET_NAME=your-gcs-bucket-name
# Optional SMTP settings for local testing or production (set these for real email delivery)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Diocese of Oke-Osun

# Force logging OTP even in production (use for temporary debugging only)
FORCE_LOG_OTP=false
